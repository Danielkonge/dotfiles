command = /opt/homebrew/bin/fish -l

theme = Material Design Colors

font-family = JetBrains Mono Medium
font-family-bold = JetBrains Mono Bold
font-family-italic = JetBrains Mono Medium Italic
font-family-bold-italic = JetBrains Mono Bold Italic

background-opacity = 0.75
background-opacity-cells = true
background-blur = macos-glass-regular

# scrollback-limit in bytes: 100_000_000 = 100MB
scrollback-limit = 100000000

window-padding-x = 6
window-padding-y = 2,4

shell-integration = fish
shell-integration-features = cursor, no-sudo, title, ssh-env, ssh-terminfo, path

macos-window-buttons = hidden
macos-titlebar-style = tabs
macos-option-as-alt = left

# Keybindings
keybind = shift+arrow_up=jump_to_prompt:-1
keybind = shift+arrow_down=jump_to_prompt:1

# Leader: ctrl+space

# ctrl+space > %
keybind = ctrl+space>shift+digit_5=new_split:right
# ctrl+space > "
keybind = ctrl+space>shift+digit_2=new_split:down

keybind = opt+tab=goto_split:next
keybind = opt+shift+tab=goto_split:previous
keybind = opt+h=goto_split:left
keybind = opt+j=goto_split:down
keybind = opt+k=goto_split:up
keybind = opt+l=goto_split:right

keybind = ctrl+space>arrow_left=move_tab:-1
keybind = ctrl+space>arrow_right=move_tab:1

keybind = ctrl+space>r=reload_config

keybind = ctrl+space>s=write_scrollback_file:copy

keybind = global:cmd+å=toggle_quick_terminal
